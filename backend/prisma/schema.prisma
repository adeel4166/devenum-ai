generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CEO
  ADMIN
  AUDITOR
}

enum Department {
  LEADERSHIP
  ARCHITECTURE
  DESIGN
  ENGINEERING
  QA_SECURITY
  DEVOPS
}

enum ModelProvider {
  CLAUDE_CODE
  GEMINI_API
}

enum AgentStatus {
  AVAILABLE
  RUNNING
  WAITING_APPROVAL
  BLOCKED
  PAUSED
  FAILED
  DISABLED
}

enum ProjectCategory {
  WEB
  MOBILE_APP
  GAME
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  FROZEN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  READY
  AWAITING_APPROVAL
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  NEEDS_RETRY
}

enum ActionType {
  GIT_BRANCH_WRITE
  DB_MIGRATION
  DEPLOY_STAGING
  CONFIG_CHANGE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CHANGES_REQUESTED
  INVALIDATED
}

enum Decision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum ActorType {
  CEO
  AGENT
  SYSTEM
  DISCORD_CEO
}

enum MergeStatus {
  MERGED
  FAILED
}


model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(CEO)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  approvals    Approval[]
}

model Agent {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  name          String
  roleTitle     String
  department    Department
  modelProvider ModelProvider
  status        AgentStatus   @default(AVAILABLE)
  manifest      Json
  currentTaskId Int?
  totalRuns     Int           @default(0)
  createdAt     DateTime      @default(now())
  tasks         Task[]        @relation("AssignedTasks")
  proposals     Proposal[]
  runs          AgentRun[]

  @@index([department])
  @@index([status])
}

model Project {
  id              Int             @id @default(autoincrement())
  name            String
  slug            String          @unique
  category        ProjectCategory
  description     String          @db.Text
  techStack       String
  repoPath        String
  gitBranch       String          @default("main")
  /// Set by devenum-bot after the first successful GitHub push.
  githubRepoUrl   String?
  /// Permanent PM2 deploy (live-<slug>) — set by POST /projects/:id/deploy.
  livePort        Int?
  liveUrl         String?
  liveDeployedAt  DateTime?
  /// Emergency control: the worker skips (and stops) work on frozen projects and holds their merges.
  isFrozen        Boolean         @default(false)
  /// Discord #proj-<slug> channel created by devenum-bot.
  discordChannelId String?
  status          ProjectStatus   @default(PLANNING)
  progressPercent Int             @default(0)
  createdAt       DateTime        @default(now())
  tasks           Task[]
  proposals       Proposal[]
  decisions       ProjectDecision[]

  @@index([status])
}

model Task {
  id              Int        @id @default(autoincrement())
  projectId       Int
  assignedAgentId Int?
  title           String
  description     String     @db.Text
  priority        Priority   @default(MEDIUM)
  status          TaskStatus @default(BACKLOG)
  dependencies    Json?
  /// Follow-up of an earlier task (Request Changes): the worker branches from task/<parentTaskId>.
  parentTaskId    Int?
  /// Time breakdown: queued (READY) → started (worker claim) → completed (run finished) → approved (CEO).
  queuedAt        DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  approvedAt      DateTime?
  /// Discord task thread inside the project's channel, and the last status posted there.
  discordThreadId   String?
  discordLastStatus String?
  outputSummary   String?    @db.Text
  executionTimeMs Int?
  createdAt       DateTime   @default(now())
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedAgent   Agent?     @relation("AssignedTasks", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  proposals       Proposal[]
  runs            AgentRun[]

  @@index([projectId, status])
  @@index([assignedAgentId])
}

model Proposal {
  id                Int            @id @default(autoincrement())
  projectId         Int
  taskId            Int?
  requestingAgentId Int
  actionType        ActionType
  targetResource    String
  scopeSummary      String         @db.Text
  rationale         String         @db.Text
  riskLevel         RiskLevel
  rollbackPlan      String         @db.Text
  validationPlan    String         @db.Text
  status            ProposalStatus @default(PENDING)
  expiresAt         DateTime
  /// Git branch produced by the worker (task/<taskId>); null for proposals not backed by a branch.
  branchName        String?
  /// Files changed on branchName relative to main (JSON array of paths).
  changedFiles      Json?
  mergeStatus       MergeStatus?
  mergeCommit       String?
  mergeError        String?        @db.Text
  mergedAt          DateTime?
  /// Discord alert bookkeeping (set by devenum-bot).
  discordMessageId  String?
  discordNotifiedAt DateTime?
  /// When devenum-bot posted the post-merge "Push to GitHub?" card.
  githubPromptedAt  DateTime?
  /// Automated pre-approval QA gate result: { status: PASSED|WARNINGS, score, findings[], checks[] }.
  qaReport          Json?
  /// Tamper lock: sha256(branchName + head commit + diff stat) captured when the proposal was created.
  payloadHash       String?
  headCommit        String?
  approvedAt        DateTime?
  createdAt         DateTime       @default(now())
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task              Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  requestingAgent   Agent          @relation(fields: [requestingAgentId], references: [id])
  approvals         Approval[]

  @@index([status, expiresAt])
  @@index([projectId])
  @@index([discordNotifiedAt])
}

model Approval {
  id         Int      @id @default(autoincrement())
  proposalId Int
  approverId Int
  decision   Decision
  comment    String?  @db.Text
  decidedAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approver   User     @relation(fields: [approverId], references: [id])

  @@index([proposalId])
  @@index([approverId])
}

model AgentRun {
  id           Int       @id @default(autoincrement())
  agentId      Int
  taskId       Int?
  status       RunStatus @default(QUEUED)
  queuedMs     Int       @default(0)
  executionMs  Int       @default(0)
  logs         String    @db.Text
  errorMessage String?   @db.Text
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  /// When devenum-bot posted the timeout / Retry alert for this run.
  alertedAt    DateTime?
  /// When the task became READY (for queue-wait metrics).
  queuedAt     DateTime?
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([agentId, startedAt])
  @@index([taskId])
}

model AuditEvent {
  id        Int       @id @default(autoincrement())
  actorType ActorType
  actorId   String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([action])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Client quotation generated by the Executive Assistant + Software Architect (/quotes).
model Quote {
  id           Int      @id @default(autoincrement())
  clientName   String
  title        String
  requirements String   @db.Text
  hourlyRate   Int
  currency     String   @default("USD")
  result       Json
  projectId    Int?
  createdById  Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Project Manager team plan proposed in chat; dispatched to agents only when the CEO clicks "Approve & Assign to Team".
model TeamPlan {
  id           Int       @id @default(autoincrement())
  status       String    @default("PENDING") // PENDING | DISPATCHED | DISCARDED
  plan         Json
  projectId    Int?
  requestedBy  String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([status])
}

/// Canonical CEO decisions pinned to a project; injected into every agent prompt for that project.
model ProjectDecision {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String
  decision  String   @db.Text
  rationale String?  @db.Text
  pinnedBy  String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Executive reports (daily CEO digest), shown in the portal and posted to Discord.
model Report {
  id          Int       @id @default(autoincrement())
  kind        String    @default("DAILY")
  title       String
  body        String    @db.Text
  data        Json
  generatedBy String
  postedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}
