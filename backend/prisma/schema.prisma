generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CEO
  ADMIN
  AUDITOR
}

enum Department {
  LEADERSHIP
  ARCHITECTURE
  DESIGN
  ENGINEERING
  QA_SECURITY
  DEVOPS
}

enum ModelProvider {
  CLAUDE_CODE
  GEMINI_API
}

enum AgentStatus {
  AVAILABLE
  RUNNING
  WAITING_APPROVAL
  BLOCKED
  PAUSED
  FAILED
  DISABLED
}

enum ProjectCategory {
  WEB
  MOBILE_APP
  GAME
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  FROZEN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  READY
  AWAITING_APPROVAL
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
}

enum ActionType {
  GIT_BRANCH_WRITE
  DB_MIGRATION
  DEPLOY_STAGING
  CONFIG_CHANGE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CHANGES_REQUESTED
}

enum Decision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ActorType {
  CEO
  AGENT
  SYSTEM
}


model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(CEO)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  approvals    Approval[]
}

model Agent {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  name          String
  roleTitle     String
  department    Department
  modelProvider ModelProvider
  status        AgentStatus   @default(AVAILABLE)
  manifest      Json
  currentTaskId Int?
  totalRuns     Int           @default(0)
  createdAt     DateTime      @default(now())
  tasks         Task[]        @relation("AssignedTasks")
  proposals     Proposal[]
  runs          AgentRun[]

  @@index([department])
  @@index([status])
}

model Project {
  id              Int             @id @default(autoincrement())
  name            String
  slug            String          @unique
  category        ProjectCategory
  description     String          @db.Text
  techStack       String
  repoPath        String
  gitBranch       String          @default("main")
  status          ProjectStatus   @default(PLANNING)
  progressPercent Int             @default(0)
  createdAt       DateTime        @default(now())
  tasks           Task[]
  proposals       Proposal[]

  @@index([status])
}

model Task {
  id              Int        @id @default(autoincrement())
  projectId       Int
  assignedAgentId Int?
  title           String
  description     String     @db.Text
  priority        Priority   @default(MEDIUM)
  status          TaskStatus @default(BACKLOG)
  dependencies    Json?
  outputSummary   String?    @db.Text
  executionTimeMs Int?
  createdAt       DateTime   @default(now())
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedAgent   Agent?     @relation("AssignedTasks", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  proposals       Proposal[]
  runs            AgentRun[]

  @@index([projectId, status])
  @@index([assignedAgentId])
}

model Proposal {
  id                Int            @id @default(autoincrement())
  projectId         Int
  taskId            Int?
  requestingAgentId Int
  actionType        ActionType
  targetResource    String
  scopeSummary      String         @db.Text
  rationale         String         @db.Text
  riskLevel         RiskLevel
  rollbackPlan      String         @db.Text
  validationPlan    String         @db.Text
  status            ProposalStatus @default(PENDING)
  expiresAt         DateTime
  createdAt         DateTime       @default(now())
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task              Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  requestingAgent   Agent          @relation(fields: [requestingAgentId], references: [id])
  approvals         Approval[]

  @@index([status, expiresAt])
  @@index([projectId])
}

model Approval {
  id         Int      @id @default(autoincrement())
  proposalId Int
  approverId Int
  decision   Decision
  comment    String?  @db.Text
  decidedAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approver   User     @relation(fields: [approverId], references: [id])

  @@index([proposalId])
  @@index([approverId])
}

model AgentRun {
  id           Int       @id @default(autoincrement())
  agentId      Int
  taskId       Int?
  status       RunStatus @default(QUEUED)
  queuedMs     Int       @default(0)
  executionMs  Int       @default(0)
  logs         String    @db.Text
  errorMessage String?   @db.Text
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([agentId, startedAt])
  @@index([taskId])
}

model AuditEvent {
  id        Int       @id @default(autoincrement())
  actorType ActorType
  actorId   String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([action])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
