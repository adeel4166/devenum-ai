DATABASE_URL="mysql://root:password@localhost:3306/devenum_ai"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4200
CORS_ORIGIN="http://localhost:4201"
# Shared secret for devenum-bot -> /api/bot (generate: openssl rand -hex 32). Must match bot/.env.
BOT_SERVICE_TOKEN=""
WORKSPACES_DIR="/opt/devenum-ai/workspaces"
# GitHub push from the portal and Discord (classic PAT with "repo", or fine-grained with Administration+Contents write).
GITHUB_TOKEN=""
GITHUB_USERNAME=""
# Optional overrides
# PREVIEW_PUBLIC_HOST=""          # host/IP used in preview URLs (default: first public IPv4)
# PREVIEW_PORT_MIN=5101
# PREVIEW_PORT_MAX=5199
# HANDOFF_AGENT_SLUG="software-architect"
# CHAT_CLAUDE_MODEL=""
