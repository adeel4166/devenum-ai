DISCORD_BOT_TOKEN=""
# Server (guild) where slash commands are registered.
DISCORD_GUILD_ID=""
# Channel that receives new-proposal alerts with Approve / Reject buttons.
DISCORD_APPROVAL_CHANNEL_ID=""
BACKEND_URL="http://127.0.0.1:4200"
# Must equal BOT_SERVICE_TOKEN in backend/.env.
BOT_SERVICE_TOKEN=""
# Comma-separated Discord user IDs allowed to create projects/tasks and approve/reject.
# If empty, only members with the Administrator permission are allowed.
DISCORD_ALLOWED_USER_IDS=""
PROPOSAL_POLL_INTERVAL_MS=10000
# --- Executive Assistant chat (/ask and @mentions) ---
# Optional free-chat channels by name or ID (e.g. "general,chat"); needs Message Content Intent ON. Empty = mention-only.
DISCORD_CHAT_CHANNELS=""
CHAT_AGENT_SLUG="executive-assistant"
CHAT_TIMEOUT_MS=60000
CHAT_MAX_CONCURRENT=2
# Optional --model for chat (e.g. a faster model). Empty = Claude Code default.
CHAT_CLAUDE_MODEL=""
