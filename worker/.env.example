# DATABASE_URL is read from ../backend/.env when not set here.
# DATABASE_URL="mysql://user:pass@localhost:3306/devenum_ai"
WORKSPACES_DIR="/opt/devenum-ai/workspaces"
# OS user that runs Claude Code and git when the worker itself runs as root.
RUN_AS_USER="devenum"
POLL_INTERVAL_MS=5000
CLAUDE_BIN="claude"
# Optional: pass --model to Claude Code (e.g. claude-opus-5-5). Empty = CLI default.
CLAUDE_MODEL=""
# Used only for agents switched to GEMINI_API while Setting.geminiApiKey is non-empty.
GEMINI_MODEL="gemini-2.5-pro"
